{
	"name": "@curry-battle/react-multiple-image-form-manager",
	"version": "0.2.0",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react-hook-form": {
			"import": {
				"types": "./dist/react-hook-form/index.d.mts",
				"default": "./dist/react-hook-form/index.mjs"
			},
			"require": {
				"types": "./dist/react-hook-form/index.d.cts",
				"default": "./dist/react-hook-form/index.cjs"
			}
		},
		"./tanstack-form": {
			"import": {
				"types": "./dist/tanstack-form/index.d.mts",
				"default": "./dist/tanstack-form/index.mjs"
			},
			"require": {
				"types": "./dist/tanstack-form/index.d.cts",
				"default": "./dist/tanstack-form/index.cjs"
			}
		},
		"./schemas/zod": {
			"import": {
				"types": "./dist/schemas/zod.d.mts",
				"default": "./dist/schemas/zod.mjs"
			},
			"require": {
				"types": "./dist/schemas/zod.d.cts",
				"default": "./dist/schemas/zod.cjs"
			}
		},
		"./schemas/valibot": {
			"import": {
				"types": "./dist/schemas/valibot.d.mts",
				"default": "./dist/schemas/valibot.mjs"
			},
			"require": {
				"types": "./dist/schemas/valibot.d.cts",
				"default": "./dist/schemas/valibot.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsdown && pnpm run verify:isolation",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"verify:isolation": "node scripts/check-bundle-isolation.mjs"
	},
	"peerDependencies": {
		"@tanstack/react-form": "^1.33",
		"react": "^19",
		"react-hook-form": "^7.50",
		"valibot": "^1.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"react-hook-form": {
			"optional": true
		},
		"@tanstack/react-form": {
			"optional": true
		},
		"zod": {
			"optional": true
		},
		"valibot": {
			"optional": true
		}
	},
	"devDependencies": {
		"@hookform/resolvers": "5.4.0",
		"@tanstack/form-core": "1.33.2",
		"@tanstack/react-form": "1.33.2",
		"@types/react": "^19.1.16",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/browser": "4.1.10",
		"@vitest/browser-playwright": "4.1.10",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "7.65.0",
		"tsdown": "0.22.11",
		"typescript": "7.0.2",
		"valibot": "1.4.2",
		"vitest": "4.1.10",
		"vitest-browser-react": "2.2.0",
		"zod": "4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/curry-battle/react-multiple-image-form-manager.git",
		"directory": "packages/react-multiple-image-form-manager"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	}
}
